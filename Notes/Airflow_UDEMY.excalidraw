    {
      "id": "BkJTXl1OwHLIKt4VJFKdG",
      "type": "text",
      "x": 325.92097981770826,
      "y": 14674.084626565931,
      "width": 715.4277954101562,
      "height": 585,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGO",
      "roundness": null,
      "seed": 1986394317,
      "version": 519,
      "versionNonce": 1810295483,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775664090366,
      "link": null,
      "locked": false,
      "text": "1) Turn on virtualization.\n2) Enable WSL & VMP.\n    \"Turn Windows Features on or off\"\n3) Restart the system.\n4) Download Docker Desktop App.\n5) Restart the system and open Docker.\n6) Open CMD\n    Run \"wsl --install\"\n    Run \"wsl --list -v\"\n7) Open CMD\n    Run \"wsl --install -d Ubuntu\"\n    Run \"wsl --list -v\"\n8) If Docker doesn't start",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) Turn on virtualization.\n2) Enable WSL & VMP.\n    \"Turn Windows Features on or off\"\n3) Restart the system.\n4) Download Docker Desktop App.\n5) Restart the system and open Docker.\n6) Open CMD\n    Run \"wsl --install\"\n    Run \"wsl --list -v\"\n7) Open CMD\n    Run \"wsl --install -d Ubuntu\"\n    Run \"wsl --list -v\"\n8) If Docker doesn't start",
      "autoResize": true,
      "lineHeight": 1.25
    },
